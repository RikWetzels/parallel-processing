# CUDA Environment Configuration
# Copy this file to .env and adjust paths as needed for your system

# CUDA 13.1 Installation Path
CUDA_PATH=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.1

# cuTile Environment Variables
# Enable crash dump for TileCompilerExecutionError or TileCompilerTimeoutError
CUDA_TILE_ENABLE_CRASH_DUMP=1

# Set compiler timeout (in seconds) - adjust as needed
CUDA_TILE_COMPILER_TIMEOUT_SEC=300

# Print cuTile Python IR during compilation (for debugging TileTypeError)
CUDA_TILE_LOGS=CUTILEIR

# Configure temporary files directory
# Note: %TEMP% will need to be resolved to your system's temp directory
CUDA_TILE_TEMP_DIR=${TEMP}\cuda_tile
